{
  "name": "homeroom",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet'",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:appimage": "bash scripts/build-appimage.sh",
    "android:apk": "bash -c 'touch src-tauri/src/lib.rs && source scripts/android-env.sh && tauri android build -d -t aarch64 --apk'",
    "android:apk:release": "bash -c 'touch src-tauri/src/lib.rs && source scripts/android-env.sh && tauri android build -t aarch64 --apk'",
    "android:dev": "bash -c 'source scripts/android-env.sh && tauri android dev'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "lucide-react": "^0.510.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
